# CertifyPro backend — environment variables
# Spring Boot reads these from the process environment (not from a .env file unless you use a tool like dotenv).
# Windows PowerShell: $env:MYSQL_PASSWORD="secret"; mvn spring-boot:run
# Unix: export MYSQL_PASSWORD=secret && mvn spring-boot:run

# ── Database ─────────────────────────────────────────
MYSQL_URL=jdbc:mysql://localhost:3306/certifypro?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=

# ── JWT (use a long random secret in production) ───
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=604800000

# ── Email ────────────────────────────────────────────
# true = OTP codes only in server logs (best for local dev)
EMAIL_MOCK=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=CertifyPro <noreply@yourdomain.com>

# ── Demo data ────────────────────────────────────────
# Set true once to seed admin + demo users/certs (see DataSeeder.java)
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin

# ── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Optional ─────────────────────────────────────────
FILE_UPLOAD_DIR=uploads
PORT=8080
LOG_LEVEL_CERTIFYPRO=INFO
